{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Таблица распределения (вход для local.bptable)",
  "type": "object",
  "required": ["rows"],
  "additionalProperties": false,
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["period", "project", "expense", "amount"],
        "properties": {
          "period":       { "type": "string", "description": "Дата в формате ДД.ММ.ГГГГ (конец месяца). Время не нужно." },
          "division":     { "$ref": "#/$defs/ref", "description": "Дивизион. id — ID записи HL-блока 32, если известен." },
          "organization": { "$ref": "#/$defs/ref", "description": "Организация. id — ID CRM-компании (мои реквизиты)." },
          "project":      { "$ref": "#/$defs/ref", "description": "Проект. id — ID элемента смарт-процесса 140." },
          "expense":      { "$ref": "#/$defs/ref", "description": "Статья. id — ID элемента смарт-процесса 150." },
          "employee":     { "$ref": "#/$defs/ref", "description": "Сотрудник (только для ЗП). id — ID пользователя Б24, если уверен; иначе только title." },
          "amount":       { "type": "number", "description": "Сумма в тенге, число без пробелов." }
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id":    { "type": ["integer", "null"], "description": "ID в Б24 из переданного справочника. null, если не уверен." },
        "title": { "type": "string", "description": "Название как в справочнике." }
      }
    }
  }
}
