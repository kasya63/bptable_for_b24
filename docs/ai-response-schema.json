{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Таблица распределения (вход для local.bptable)",
  "type": "object",
  "required": [
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project",
          "expense",
          "employee",
          "amount"
        ],
        "properties": {
          "project": {
            "$ref": "#/$defs/ref",
            "description": "Проект. id — ID элемента смарт-процесса 140."
          },
          "expense": {
            "$ref": "#/$defs/ref",
            "description": "Статья. id — ID элемента смарт-процесса 150."
          },
          "employee": {
            "type": "string",
            "description": "ФИО сотрудника как в заявке; для позиции без сотрудника — её текст"
          },
          "amount": {
            "type": "number",
            "description": "Сумма в тенге, число без пробелов."
          }
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "ID в Б24 из переданного справочника. null, если не уверен."
        },
        "title": {
          "type": "string",
          "description": "Название как в справочнике."
        }
      }
    }
  }
}